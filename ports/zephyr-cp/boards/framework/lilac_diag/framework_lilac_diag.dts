/dts-v1/;

#include <nuvoton/npcx9m3f.dtsi>
#include <nuvoton/npcx/npcx9/npcx9-pinctrl.dtsi>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/sensor/npcx_tach.h>

/ {
    model = "Framework Lilac AP-off diagnostic candidate";
    compatible = "framework,lilac-diag";

    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,console = &uart1;
    };

    // Green battery LED, as stock laptop13/led_pins.dtsi. Native heartbeat only.
    lilac-leds {
        compatible = "pwm-leds";
        pwm_led_green: led-green {
            pwms = <&pwm4 0 PWM_HZ(324) PWM_POLARITY_NORMAL>;
        };
    };
};

&pwm4 {
    status = "okay";
    clock-bus = "NPCX_CLOCK_BUS_LFCLK";
    pinctrl-0 = <&pwm4_gpb6>;
    pinctrl-names = "default";
};

// Fan, as stock laptop13/fan.dtsi: PWM0 on GPC3 (open-drain), tach TA2 on
// GP73 sampled from LFCLK, 2 pulses per turn. The fan is powered only in S0;
// native fan.c applies duty 0 while slp_s3_l is low.
&pwm0_gpc3 {
    drive-open-drain;
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_gpc3>;
    pinctrl-names = "default";
};

&tach2 {
    status = "okay";
    pinctrl-0 = <&ta2_1_in_gp73>;
    pinctrl-names = "default";
    port = <NPCX_TACH_PORT_A>;
    sample-clk = <NPCX_TACH_FREQ_LFCLK>;
    pulses-per-round = <2>;
};

// Charger/battery SMBus, as stock lilac/i2c.dtsi. Native reads only; the
// smart battery at 0x0b is not addressed. Neutral compatible: no driver.
&i2c_ctrl3 { status = "okay"; };
&i2c3_0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    pinctrl-0 = <&i2c3_0_sda_scl_gpd0_d1>;
    pinctrl-names = "default";

    lilac_charger: charger@9 {
        compatible = "vnd,i2c-device";
        reg = <0x9>;
    };
};

// Sensor bus, as stock. Only the F75303 is addressed; the APU SB-TSI (0x4c)
// and ALS (0x29) are not.
&i2c_ctrl7 { status = "okay"; };
&i2c7_0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&i2c7_0_sda_scl_gpb2_b3>;
    pinctrl-names = "default";

    lilac_thermal: thermal@4d {
        compatible = "vnd,i2c-device";
        reg = <0x4d>;
    };
};

// ADC, as stock laptop13/adc.dtsi (= release azalea/adc.dtsi): six channels
// on their stock pads. Native adc.c reads them; read-only.
&adc0 {
    status = "okay";
    pinctrl-0 = <&adc0_chan0_gp45
                 &adc0_chan4_gp41
                 &adc0_chan5_gp37
                 &adc0_chan7_gpe1
                 &adc0_chan8_gpf1
                 &adc0_chan9_gpf0>;
    pinctrl-names = "default";
};

// Host interface, as stock lilac/gpio.dtsi. Native espi.c owns it.
&espi0 {
    status = "okay";
    pinctrl-0 = <&espi_lpc_gp46_47_51_52_53_54_55_57>;
    pinctrl-names = "default";
};

// Same console routing as Framework's NPCX9 EC board definition.
&uart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart1_2_sin_gp64 &uart1_2_sout_gp65>;
    pinctrl-names = "default";
};

// NPCX GPIO ports have eight pins, rather than the generator's 32-pin default.
&gpio0 { ngpios = <8>; };
&gpio1 { ngpios = <8>; };
&gpio2 { ngpios = <8>; };
&gpio3 { ngpios = <8>; };
&gpio4 { ngpios = <8>; };
&gpio5 { ngpios = <8>; };
&gpio6 { ngpios = <8>; };
&gpio7 { ngpios = <8>; };
&gpio8 { ngpios = <8>; };
&gpio9 { ngpios = <8>; };
&gpioa { ngpios = <8>; };
&gpiob { ngpios = <8>; };
&gpioc { ngpios = <8>; };
&gpiod { ngpios = <8>; };
&gpioe { ngpios = <8>; };
&gpiof { ngpios = <8>; };

// CIRCUITPY storage: littlefs (power-loss tolerant) in the upper flash half,
// the same region the generic NPCX993 target uses for FAT. The firmware image
// (header + payload, under 0x41000) stays outside it; flash_area bounds every
// filesystem access to this partition. Stale stock bytes here are replaced by
// the first format. The stock image is backed up externally.
&int_flash {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        littlefs_partition: partition@41000 {
            label = "circuitpy";
            reg = <0x41000 0x3f000>;
        };
    };
};
